# Copia este archivo como .env y completa tus datos. El .env NUNCA se sube al repositorio.

# Clave secreta de Django. Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# True en tu equipo, False en producción
DEBUG=True

# Dominios separados por comas
ALLOWED_HOSTS=127.0.0.1,localhost

# PostgreSQL
DB_NAME=vitrina_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Correo (Gmail). EMAIL_HOST_PASSWORD es la contraseña de aplicación de 16 caracteres,
# sin espacios. Si la dejas vacía, los correos se muestran en la terminal.
EMAIL_HOST_USER=vitrinadeproyectosuteq@gmail.com
EMAIL_HOST_PASSWORD=

# Opcional. Dirección pública del sitio para los QR, sin barra al final. Si la dejas vacía se usa
# la dirección con la que entras. Para probar el QR con el celular en la misma red Wi-Fi, pon la IP
# de tu equipo (por ejemplo http://192.168.1.20:8000), agrégala a ALLOWED_HOSTS y arranca con
#   python manage.py runserver 0.0.0.0:8000
SITIO_URL=

# Clave con la que se cifra la contraseña del correo de envío que un admin guarda desde la app
# (Mi panel → Correo de envío). Sin ella la app no deja guardar una contraseña nueva, pero el correo
# de arriba (EMAIL_HOST_*) sigue funcionando. Genera una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si la cambias, la contraseña guardada deja de poder leerse y hay que escribirla de nuevo.
CLAVE_CIFRADO=

# Opcional. Cuánto detalle escribe Django en la consola (y en `docker compose logs` o `journalctl`):
# DEBUG, INFO, WARNING, ERROR o CRITICAL. Por defecto INFO. Los avisos de la app (por ejemplo el
# código de la configuración inicial) salen siempre, también con DEBUG=False.
NIVEL_LOG_DJANGO=INFO
